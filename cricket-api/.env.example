# CricPro backend (cricket-api) environment template.
# Copy to `.env` and fill in real values. NEVER commit a real `.env`.

# --- Runtime ---
NODE_ENV=development
PORT=5000
HOST=0.0.0.0

# --- Database (MySQL) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=your_db_name
DB_POOL_MIN=2
DB_POOL_MAX=20

# --- Redis ---
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=your_redis_password

# --- Auth ---
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=7d
API_KEY_HEADER=x-api-key

# --- Rate limiting ---
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# --- Data providers ---
CRICBUZZ_BASE_URL=https://www.cricbuzz.com
CRICKETDATA_API_KEY=your_cricketdata_api_key
CRICKETDATA_BASE_URL=https://api.cricapi.com/v1
CRICINFO_BASE_URL=https://hs-consumer-api.espncricinfo.com/v1

# --- Push notifications (OneSignal) ---
ONESIGNAL_APP_ID=your_onesignal_app_id
ONESIGNAL_REST_API_KEY=your_onesignal_rest_api_key

# --- Admin seed (first-run admin account) ---
ADMIN_SEED_EMAIL=admin@example.com
ADMIN_SEED_PASSWORD=change-this-admin-password

# --- Polling intervals (ms) ---
POLL_LIVE_INTERVAL=3000
POLL_INNINGS_BREAK_INTERVAL=15000
POLL_UPCOMING_INTERVAL=300000
POLL_COMMENTARY_INTERVAL=5000
POLL_SCORECARD_INTERVAL=10000

# --- Workers ---
WORKER_CONCURRENCY=5
WORKER_LIMITER_MAX=10
WORKER_LIMITER_DURATION=1000

# --- WebSocket ---
WS_HEARTBEAT_INTERVAL=30000
WS_MAX_CONNECTIONS=50000

# --- Monitoring ---
LOG_LEVEL=info
METRICS_ENABLED=true
METRICS_PORT=9090

# --- CORS ---
CORS_ORIGIN=*

# --- API Security / Access Control ---
# Initial enforcement mode for the API-security layer. One of: monitor | enforce | off.
#   monitor  : logs would-be blocks but allows traffic (safe default for rollout)
#   enforce  : rejects requests that fail any rule (no public access without permission)
#   off      : skips all checks (logs only)
# This is only the INITIAL default; the live value is controlled from the
# Admin Panel (API Security > mode) and stored in app_settings.apiSecurityMode.
API_SECURITY_MODE=monitor

# Origin of the deployed Admin Panel. Auto-allowed by CORS + seeded into
# api_allowed_origins so the admin panel is never locked out. MUST match the
# real admin panel origin in production.
ADMIN_PANEL_ORIGIN=https://admin.webcrichd.co

# Default public app API key seeded for the "CricPro Android (default)" client.
# Must match the Flutter app's CRICKET_API_KEY build define. Rotate from the
# Admin Panel (regenerate key) for production and rebuild the app with the new key.
APP_PUBLIC_API_KEY=csk_live_cricpro_app_8f3a2b1c9d
