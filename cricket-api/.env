# ====================================================
# Cricket Scoring API — Environment Configuration
# ====================================================

# Server
NODE_ENV=development
PORT=5000
HOST=0.0.0.0

# MySQL / Percona
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=crickadmin
DB_POOL_MIN=2
DB_POOL_MAX=20

# Redis
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# Auth
JWT_SECRET=change-this-to-a-very-long-random-string-in-production-$(date +%s)
JWT_EXPIRES_IN=7d
API_KEY_HEADER=x-api-key

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# Provider: Cricbuzz
CRICBUZZ_BASE_URL=https://www.cricbuzz.com

# Provider: CricketData.org (fallback)
CRICKETDATA_API_KEY=
CRICKETDATA_BASE_URL=https://api.cricapi.com/v1

# Provider: ESPN Cricinfo (fallback)
CRICINFO_BASE_URL=https://hs-consumer-api.espncricinfo.com/v1

# Polling Intervals (ms)
POLL_LIVE_INTERVAL=3000
POLL_INNINGS_BREAK_INTERVAL=15000
POLL_UPCOMING_INTERVAL=300000
POLL_COMMENTARY_INTERVAL=5000
POLL_SCORECARD_INTERVAL=10000

# Workers
WORKER_CONCURRENCY=5
WORKER_LIMITER_MAX=10
WORKER_LIMITER_DURATION=1000

# WebSocket
WS_HEARTBEAT_INTERVAL=30000
WS_MAX_CONNECTIONS=50000

# Monitoring
LOG_LEVEL=debug
METRICS_ENABLED=true
METRICS_PORT=9090

# CORS
CORS_ORIGIN=*
