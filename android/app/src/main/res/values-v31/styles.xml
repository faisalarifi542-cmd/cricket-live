<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ (API 31) mandatory SplashScreen API configuration.
         Sets the system splash to dark navy with a transparent icon so the user
         sees only a dark screen before Flutter's animated splash takes over.
         Duration is minimal so the system splash exits as fast as possible. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowSplashScreenBackground">@color/splash_navy</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_transparent</item>
        <item name="android:windowSplashScreenAnimationDuration">0</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/splash_navy</item>
    </style>
</resources>
