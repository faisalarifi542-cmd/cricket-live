<?xml version="1.0" encoding="utf-8"?>
<!-- Premium CricPro dark-glass bubble: deep navy gradient, rounded corners and a
     subtle cyan border for the stadium-glass look. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="90"
        android:startColor="#F50E1B30"
        android:endColor="#F5070E1A" />
    <corners android:radius="20dp" />
    <stroke
        android:width="1dp"
        android:color="#9922D3EE" />
</shape>
