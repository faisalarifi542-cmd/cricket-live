<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Theme applied to the Android Window while the process is starting.
         Uses a dark base so the status/navigation bars are dark — no white flash
         before Flutter renders the CricPro splash. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowFullscreen">true</item>
    </style>
    <!-- Theme applied as soon as the process has started (NormalTheme).
         Flutter's first frame replaces this; the dark background ensures no
         white flicker behind the Flutter UI during init. -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/splash_navy</item>
    </style>
</resources>
